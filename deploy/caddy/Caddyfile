{
  email {$ACME_EMAIL}
}

{$DOMAIN} {
  encode gzip zstd

  header {
    Strict-Transport-Security "max-age=31536000"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    X-Frame-Options "DENY"
    -Server
  }

  log {
    output stdout
    format console
  }

  reverse_proxy bolsi-web:80
}
